---
import '../styles/global.css';
// 自托管字体（替代 Google Fonts 外链）：CJK 走 unicode-range 切片按需加载。
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/700.css';
import CommandPalette from '../components/CommandPalette.astro';
import { assetHref } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** 覆盖默认社交卡片图（站点相对路径，如 /og.png）。 */
  ogImage?: string;
  /** 注入 <script type="application/ld+json"> 结构化数据。 */
  jsonLd?: object | object[];
}

const {
  title,
  description = 'Linux 命令速查手册：名称与说明全文搜索，适合日常查阅。',
  bodyClass = '',
  ogImage,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage ?? '/og.png', siteOrigin).href;
const jsonLdString = jsonLd ? JSON.stringify(jsonLd) : '';
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0c0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Linux Command" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Linux Command — 高密度命令手册速查" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={assetHref('favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    {jsonLdString && (
      <script type="application/ld+json" is:inline set:html={jsonLdString} />
    )}
    <script is:inline>
      (function () {
        const key = 'linux_command_theme';
        const stored = localStorage.getItem(key);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <CommandPalette />
    <button class="back-to-top focus-ring" id="back_to_top" type="button" aria-label="回到顶部" hidden>
      ↑
    </button>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
