---
interface Props {
  type?: 'home' | 'page';
  initialQuery?: string;
}

const { type = 'page', initialQuery = '' } = Astro.props;
const isHome = type === 'home';
---
<div class:list={['search-box', { 'search-box--home': isHome }]} data-search-root>
  <label class="search-box__label" for="query">
    {isHome ? '搜索命令' : '搜索'}
  </label>
  <div class="search-box__row">
    <span class="search-box__prompt" aria-hidden="true">/</span>
    <input
      class="search-box__input focus-ring"
      id="query"
      name="query"
      type="search"
      role="combobox"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      placeholder={isHome ? '命令名或说明关键词…' : '过滤结果…'}
      value={initialQuery}
      aria-controls="result"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-haspopup="listbox"
    />
    <button class="search-box__btn focus-ring" id="search_btn" type="button">Go</button>
  </div>
  {!isHome && (
    <p class="search-box__hint muted">
      <kbd>/</kbd> 聚焦 · <kbd>Ctrl</kbd>+<kbd>K</kbd> 面板 · 方向键选择
    </p>
  )}
  <ul
    class="search-box__result cmd-list"
    id="result"
    role="listbox"
    aria-label="搜索建议"
    hidden
  ></ul>
  {isHome && (
    <div class="search-tips" aria-label="搜索示例">
      <span class="search-tips__label muted">试:</span>
      <button class="search-tip focus-ring" type="button" data-kw="ls">ls</button>
      <button class="search-tip focus-ring" type="button" data-kw="查找文件">查找文件</button>
      <button class="search-tip focus-ring" type="button" data-kw="chmod">chmod</button>
      <button class="search-tip focus-ring" type="button" data-kw="网络">网络</button>
    </div>
  )}
</div>

<style>
  .search-box {
    position: relative;
    width: min(100%, 680px);
  }

  .search-box--home {
    width: min(100%, 760px);
  }

  .search-box__label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .search-box__row {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .search-box__prompt {
    display: grid;
    place-items: center;
    padding: 0 0.65rem;
    border-right: 1px solid var(--line);
    background: var(--bg-subtle);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .search-box__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 500 max(16px, 0.95rem) / 1.4 var(--font-mono);
    padding: 0.65rem 0.75rem;
  }

  .search-box__input::placeholder {
    color: var(--ink-muted);
    font-weight: 400;
  }

  .search-box__btn {
    border: 0;
    border-left: 1px solid var(--line-strong);
    background: var(--ink);
    color: var(--bg);
    font: 600 0.8rem/1 var(--font-mono);
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 1rem;
    cursor: pointer;
    letter-spacing: 0.04em;
  }

  html[data-theme='dark'] .search-box__btn {
    background: var(--accent);
    color: var(--bg);
  }

  .search-box__btn:hover {
    filter: brightness(1.08);
  }

  .search-box__hint {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
  }

  .search-box__result {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 0.35rem);
    max-height: min(360px, 50vh);
    overflow: auto;
  }

  .search-box__result[hidden] {
    display: none;
  }

  .search-tips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .search-tips__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .search-tip {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--ink-muted);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    font: 500 0.78rem/1 var(--font-mono);
  }

  .search-tip:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
</style>
