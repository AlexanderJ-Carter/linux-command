---
import { withBase } from '../lib/paths';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--compact': compact }]}>
  <div class="shell site-header__inner">
    <a class="brand focus-ring" href={withBase('/')}>
      <span class="brand__mark" aria-hidden="true">man</span>
      <span class="brand__text">linux-command</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a class="focus-ring" href={withBase('/hot')}>A–Z</a>
      <a class="focus-ring" href={withBase('/category')}>分类</a>
      <a class="focus-ring" href={withBase('/list')}>搜索</a>
      <button class="cmdk-trigger focus-ring" id="cmdk_open" type="button" aria-label="打开命令面板">
        <span class="cmdk-trigger__label">面板</span>
        <kbd>Ctrl+K</kbd>
      </button>
      <button class="theme-toggle focus-ring" id="theme_toggle" type="button" aria-label="切换浅色/暗色主题">
        <span aria-hidden="true" class="theme-toggle__icon">◐</span>
        <span class="sr-only">主题</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg-elevated);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: -0.02em;
  }

  .brand__mark {
    display: inline-block;
    padding: 0.12rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    color: var(--accent-strong);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-nav a,
  .theme-toggle,
  .cmdk-trigger {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.2rem 0.35rem;
    font-family: var(--font-mono);
  }

  .site-nav a:hover,
  .theme-toggle:hover,
  .cmdk-trigger:hover {
    color: var(--accent-strong);
  }

  .cmdk-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.15rem 0.45rem;
    background: var(--bg);
  }

  .cmdk-trigger kbd {
    font-size: 0.68rem;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0;
  }

  .theme-toggle__icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .brand__text {
      font-size: 0.82rem;
    }

    .site-nav {
      gap: 0.35rem;
    }

    .cmdk-trigger__label {
      display: none;
    }

    .cmdk-trigger kbd {
      display: none;
    }

    .cmdk-trigger {
      padding: 0.15rem 0.35rem;
    }

    .cmdk-trigger::before {
      content: '⌘';
      font-size: 0.85rem;
    }
  }
</style>
