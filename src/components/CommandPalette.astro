---
/** 全局命令面板：Ctrl/Cmd+K 打开 */
---
<div class="cmdk" id="cmdk" hidden>
  <div class="cmdk__backdrop" data-cmdk-close tabindex="-1" aria-hidden="true"></div>
  <div
    class="cmdk__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cmdk_title"
  >
    <div class="cmdk__header">
      <label class="sr-only" for="cmdk_input" id="cmdk_title">命令面板</label>
      <span class="cmdk__prompt" aria-hidden="true">›</span>
      <input
        class="cmdk__input focus-ring"
        id="cmdk_input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="命令、说明或跳转…"
      />
      <kbd class="cmdk__esc">esc</kbd>
    </div>
    <ul class="cmdk__list cmd-list" id="cmdk_list" role="listbox" aria-label="面板结果"></ul>
    <div class="cmdk__footer muted">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>esc</kbd> 关闭</span>
    </div>
  </div>
</div>

<style>
  .cmdk[hidden] {
    display: none;
  }

  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: start center;
    padding: 10vh 0.75rem 1rem;
  }

  .cmdk__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  .cmdk__panel {
    position: relative;
    width: min(100%, 580px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
    animation: cmdk-in 0.14s ease both;
  }

  .cmdk__header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-subtle);
  }

  .cmdk__prompt {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .cmdk__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 500 0.95rem/1.4 var(--font-mono);
    padding: 0.25rem 0;
  }

  .cmdk__input:focus {
    outline: none;
  }

  .cmdk__esc {
    font-size: 0.68rem;
    text-transform: lowercase;
  }

  .cmdk__list {
    border: 0;
    border-radius: 0;
    max-height: min(52vh, 400px);
    overflow: auto;
    background: transparent;
  }

  .cmdk__list :global(a),
  .cmdk__list :global(button.cmdk__item) {
    display: grid;
    grid-template-columns: minmax(5.5rem, 9rem) minmax(0, 1fr);
    gap: 0.5rem 0.75rem;
    align-items: baseline;
    width: 100%;
    padding: 0.45rem 0.65rem;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
  }

  .cmdk__list :global(.cmdk__name) {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .cmdk__list :global(.cmdk__desc) {
    color: var(--ink-muted);
  }

  .cmdk__list :global(.kw) {
    color: var(--accent-strong);
    font-style: normal;
    font-weight: 700;
  }

  .cmdk__list :global(.cmdk__empty) {
    padding: 1rem 0.75rem;
    color: var(--ink-muted);
    text-align: center;
    font-size: var(--text-sm);
  }

  .cmdk__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem 0.55rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }

  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 520px) {
    .cmdk__list :global(a),
    .cmdk__list :global(button.cmdk__item) {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
