---
import { renderMarkdown } from '../../lib/render-markdown';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SearchBox from '../../components/SearchBox.astro';
import CommandChips from '../../components/CommandChips.astro';
import EcosystemCallout from '../../components/EcosystemCallout.astro';
import { loadCommands } from '../../lib/commands';
import { relatedCommands } from '../../data/categories';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return loadCommands().map((cmd) => ({
    params: { name: cmd.p.replace(/^\//, '') },
    props: { cmd },
  }));
}

const { cmd } = Astro.props;
const commands = loadCommands();
const related = relatedCommands(cmd.n, commands);
const html = renderMarkdown(cmd.body);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? new URL(Astro.url.origin)).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${cmd.n} 命令详解`,
  name: cmd.n,
  description: cmd.d,
  inLanguage: 'zh-CN',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};
---
<BaseLayout
  title={`${cmd.n} | Linux Command`}
  description={`${cmd.n}: ${cmd.d}`}
  jsonLd={jsonLd}
  bodyClass="page-cmd"
>
  <SiteHeader compact />
  <main class="site-main" id="site_main">
    <div class="shell cmd-top">
      <SearchBox />
      <EcosystemCallout commandName={cmd.n} />
      <nav class="breadcrumb" aria-label="面包屑">
        <a href={withBase('/')}>~</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/hot')}>a-z</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{cmd.n}</span>
      </nav>
      <header
        class="cmd-page-header"
        data-cmd-name={cmd.n}
        data-cmd-path={cmd.p}
        data-cmd-desc={cmd.d}
      >
        <div class="cmd-page-header__row">
          <h1 class="cmd-page-title">{cmd.n}</h1>
          <button
            class="favorite-btn focus-ring"
            id="favorite_btn"
            type="button"
            aria-pressed="false"
          >
            ☆ 收藏
          </button>
        </div>
        <p class="cmd-page-desc">{cmd.d}</p>
      </header>
    </div>

    <div class="shell cmd-layout">
      <nav class="cmd-toc" id="cmd_toc" aria-label="本页目录" hidden></nav>
      <article class="markdown-body" data-markdown>
        <div set:html={html} />
        {related.length > 0 && (
          <section class="related-commands" aria-label="相关命令">
            <h2>相关命令</h2>
            <CommandChips items={related} label="相关命令" />
          </section>
        )}
      </article>
    </div>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>

<style>
  .cmd-top {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-strong);
  }

  .cmd-page-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cmd-page-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .favorite-btn {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--ink-muted);
    padding: 0.35rem 0.65rem;
    font: 600 var(--text-sm) / 1 var(--font-mono);
    cursor: pointer;
  }

  .favorite-btn:hover,
  .favorite-btn.is-active {
    border-color: var(--accent);
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .cmd-page-desc {
    margin: 0.35rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    max-width: var(--read-max);
  }

  .cmd-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .cmd-toc {
    position: sticky;
    top: calc(var(--header-h) + 0.65rem);
    align-self: start;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    font-size: var(--text-sm);
    max-height: calc(100vh - var(--header-h) - 2rem);
    overflow: auto;
  }

  .cmd-toc[hidden] {
    display: none;
  }

  .cmd-toc :global(.cmd-toc__title) {
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .cmd-toc :global(.cmd-toc__list) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cmd-toc :global(.cmd-toc__item) {
    margin: 0.15rem 0;
  }

  .cmd-toc :global(.cmd-toc__item--h3) {
    padding-left: 0.65rem;
    font-size: 0.78rem;
  }

  .cmd-toc :global(a) {
    color: var(--ink);
    text-decoration: none;
  }

  .cmd-toc :global(a:hover) {
    color: var(--accent-strong);
  }

  .related-commands {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    max-width: var(--read-max);
  }

  .related-commands h2 {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    margin: 0 0 0.65rem;
  }

  @media (min-width: 960px) {
    .cmd-layout {
      grid-template-columns: 11.5rem minmax(0, 1fr);
    }

    .page-cmd .markdown-body {
      padding-right: 0.5rem;
    }
  }
</style>
