---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import { loadCommands } from '../lib/commands';

const commands = loadCommands();
const initialQuery = Astro.url.searchParams.get('kw') || '';
---
<BaseLayout title="搜索结果 | Linux Command" description="按名称或说明搜索 Linux 命令">
  <SiteHeader compact />
  <main class="site-main">
    <div class="shell list-page" data-list-page>
      <SearchBox initialQuery={initialQuery} />
      <header class="page-head">
        <h1>高级搜索</h1>
        <p class="muted" id="search_meta">输入关键词开始搜索，或点击首页示例</p>
      </header>
      <ul class="cmd-list" id="search_list_result" role="listbox" aria-label="搜索结果"></ul>
      <button class="load-more focus-ring" id="load_more_btn" type="button" hidden>加载更多</button>
    </div>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>

<style>
  .list-page {
    display: grid;
    gap: 1rem;
  }

  .page-head h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 2rem;
  }

  .page-head p {
    margin: 0.35rem 0 0;
  }

  .cmd-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .cmd-list :global(a) {
    display: block;
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }

  .cmd-list :global(a:hover),
  .cmd-list :global(li.ok a) {
    background: var(--accent-soft);
  }

  .cmd-list :global(.kw) {
    color: var(--accent-strong);
    font-style: normal;
    font-weight: 700;
  }

  .load-more {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--ink);
    cursor: pointer;
    font: 600 0.9rem/1 var(--font-sans);
  }

  .load-more:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
</style>
