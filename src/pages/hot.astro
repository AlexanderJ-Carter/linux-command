---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import { groupByLetter, loadCommands } from '../lib/commands';
import { commandHref } from '../lib/paths';

const commands = loadCommands();
const groups = groupByLetter(commands);
---
<BaseLayout title="A–Z | Linux Command" description="全部 Linux 命令，按字母排序浏览">
  <SiteHeader compact />
  <main class="site-main">
    <div class="shell">
      <SearchBox />
      <header class="page-head">
        <h1>字母索引</h1>
        <p class="muted">{commands.length} 条 · 紧凑列表</p>
      </header>
      <nav class="alpha-nav" id="alpha_nav" aria-label="字母导航">
        {groups.map((group) => (
          <a class="focus-ring" href={`#letter-${group.letter}`}>{group.letter}</a>
        ))}
      </nav>
      {groups.map((group) => (
        <section class="alpha-group" id={`letter-${group.letter}`}>
          <h2>{group.letter}</h2>
          <ul class="cmd-list">
            {group.items.map((cmd) => (
              <li>
                <a class="cmd-row" href={commandHref(cmd.p)}>
                  <span class="cmd-row__name">{cmd.n}</span>
                  <span class="cmd-row__desc">{cmd.d}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>
