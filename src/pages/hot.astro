---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import { groupByLetter, loadCommands } from '../lib/commands';
import { commandHref } from '../lib/paths';

const commands = loadCommands();
const groups = groupByLetter(commands);
---
<BaseLayout title="命令列表 | Linux Command" description="全部 Linux 命令，按字母排序浏览">
  <SiteHeader compact />
  <main class="site-main">
    <div class="shell">
      <SearchBox />
      <header class="page-head">
        <h1>字母列表</h1>
        <p class="muted">共 {commands.length} 个命令</p>
      </header>
      <nav class="alpha-nav" id="alpha_nav" aria-label="字母导航">
        {groups.map((group) => (
          <a class="focus-ring" href={`#letter-${group.letter}`}>{group.letter}</a>
        ))}
      </nav>
      {groups.map((group) => (
        <section class="alpha-group" id={`letter-${group.letter}`}>
          <h2>{group.letter}</h2>
          <ul class="cmd-list">
            {group.items.map((cmd) => (
              <li>
                <a href={commandHref(cmd.p)}>
                  <strong>{cmd.n}</strong>
                  <span>{cmd.d}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>

<style>
  .page-head {
    margin: 1.25rem 0 1rem;
  }

  .page-head h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 2rem;
  }

  .page-head p {
    margin: 0.35rem 0 0;
  }

  .alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .alpha-nav a {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .alpha-nav a:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .alpha-group {
    margin-bottom: 1.75rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .alpha-group h2 {
    margin: 0 0 0.65rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
  }

  .cmd-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .cmd-list a {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }

  .cmd-list a:hover {
    background: var(--accent-soft);
  }

  .cmd-list strong {
    font-family: var(--font-mono);
  }

  .cmd-list span {
    color: var(--ink-muted);
    font-size: 0.92rem;
  }
</style>
