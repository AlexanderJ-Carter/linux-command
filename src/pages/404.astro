---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import CommandChips from '../components/CommandChips.astro';
import { getPopularCommands, loadCommands } from '../lib/commands';
import { withBase } from '../lib/paths';

const commands = loadCommands();
const popular = getPopularCommands(commands).slice(0, 10);
---
<BaseLayout
  title="页面不存在 | Linux Command"
  description="页面未找到。搜索 Linux 命令，或从常用命令继续浏览。"
>
  <SiteHeader compact />
  <main class="site-main" id="site_main">
    <section class="shell notfound">
      <p class="notfound__code" aria-hidden="true">404</p>
      <h1 class="notfound__title">页面不存在</h1>
      <p class="notfound__lead muted">
        检查 URL 或从搜索继续；常见命令见下方。
      </p>
      <SearchBox />
      <nav class="notfound__links" aria-label="站点导航">
        <a href={withBase('/')}>首页</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/hot')}>字母列表</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/category')}>分类浏览</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/list')}>高级搜索</a>
      </nav>
      {popular.length > 0 && (
        <div class="notfound__block">
          <h2 class="section-title">常用命令</h2>
          <CommandChips items={popular} label="常用命令" />
        </div>
      )}
    </section>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>

<style>
  .notfound {
    display: grid;
    gap: 0.85rem;
    max-width: 760px;
    padding-block: 2rem 3rem;
  }

  .notfound__code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--ink-muted);
  }

  .notfound__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
  }

  .notfound__lead {
    margin: 0 0 0.5rem;
    max-width: 30rem;
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }

  .notfound__links a {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
  }

  .notfound__links a:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .notfound__block {
    margin-top: 0.5rem;
  }
</style>
