---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import { loadCommands } from '../lib/commands';
import { buildCategoryGroups } from '../data/categories';
import { commandHref } from '../lib/paths';

const commands = loadCommands();
const categories = buildCategoryGroups(commands);
---
<BaseLayout title="分类 | Linux Command" description="按用途浏览 Linux 命令">
  <SiteHeader compact />
  <main class="site-main">
    <div class="shell">
      <SearchBox />
      <header class="page-head">
        <h1>分类索引</h1>
        <p class="muted">按常见运维场景分组</p>
      </header>
      <nav class="cat-nav" aria-label="分类导航">
        {categories.map((cat) => (
          <a class="focus-ring" href={`#${cat.id}`}>{cat.name}<span>{cat.count}</span></a>
        ))}
      </nav>
      {categories.map((cat) => (
        <section class="cat-group" id={cat.id}>
          <h2>{cat.name} <span class="muted">({cat.count})</span></h2>
          <ul class="cmd-list">
            {cat.items.map((cmd) => (
              <li>
                <a class="cmd-row" href={commandHref(cmd.p)}>
                  <span class="cmd-row__name">{cmd.n}</span>
                  <span class="cmd-row__desc">{cmd.d}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>
