---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import { loadCommands } from '../lib/commands';
import { buildCategoryGroups } from '../data/categories';
import { commandHref } from '../lib/paths';

const commands = loadCommands();
const categories = buildCategoryGroups(commands);
---
<BaseLayout title="分类浏览 | Linux Command" description="按用途浏览 Linux 命令">
  <SiteHeader compact />
  <main class="site-main">
    <div class="shell">
      <SearchBox />
      <header class="page-head">
        <h1>分类浏览</h1>
        <p class="muted">按用途快速定位命令族</p>
      </header>
      <nav class="cat-nav" aria-label="分类导航">
        {categories.map((cat) => (
          <a class="focus-ring" href={`#${cat.id}`}>{cat.name}<span>{cat.count}</span></a>
        ))}
      </nav>
      {categories.map((cat) => (
        <section class="cat-group" id={cat.id}>
          <h2>{cat.name} <span class="muted">({cat.count})</span></h2>
          <ul class="cmd-list">
            {cat.items.map((cmd) => (
              <li>
                <a href={commandHref(cmd.p)}>
                  <strong>{cmd.n}</strong>
                  <span>{cmd.d}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>

<style>
  .page-head {
    margin: 1.25rem 0 1rem;
  }

  .page-head h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 2rem;
  }

  .page-head p {
    margin: 0.35rem 0 0;
  }

  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .cat-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .cat-nav a span {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .cat-nav a:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .cat-group {
    margin-bottom: 2rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .cat-group h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
  }

  .cmd-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .cmd-list a {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }

  .cmd-list a:hover {
    background: var(--accent-soft);
  }

  .cmd-list strong {
    font-family: var(--font-mono);
  }

  .cmd-list span {
    color: var(--ink-muted);
    font-size: 0.92rem;
  }
</style>
