---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchBox from '../components/SearchBox.astro';
import CommandChips from '../components/CommandChips.astro';
import { getPopularCommands, loadCommands } from '../lib/commands';
import { withBase } from '../lib/paths';

const commands = loadCommands();
const popular = getPopularCommands(commands);
---
<BaseLayout
  title="Linux Command — 命令手册速查"
  description={`收录 ${commands.length} 个 Linux 命令。名称与说明全文检索，适合终端旁快速查阅。`}
  bodyClass="page-home"
>
  <SiteHeader />
  <main class="site-main">
    <section class="hero shell">
      <header class="hero__head">
        <p class="hero__tag">offline-friendly · static · {commands.length} pages</p>
        <h1 class="hero__title">Linux 命令参考</h1>
        <p class="hero__lead muted">
          高密度手册视图：搜索名称或中文说明，<kbd>Ctrl+K</kbd> 打开面板，<kbd>/</kbd> 聚焦搜索框。
        </p>
      </header>
      <SearchBox type="home" />
      <nav class="hero__links" aria-label="快捷入口">
        <a href={withBase('/hot')}>A–Z 列表</a>
        <a href={withBase('/category')}>分类索引</a>
        <a href={withBase('/list')}>全量搜索</a>
      </nav>
      {popular.length > 0 && (
        <div class="hero__block">
          <h2 class="section-title">高频命令</h2>
          <CommandChips items={popular} label="高频命令" />
        </div>
      )}
      <div class="hero__block favorite-commands" id="favorite_commands" hidden>
        <h2 class="section-title">收藏</h2>
        <div class="cmd-chips" id="favorite_commands_list" aria-label="收藏的命令"></div>
      </div>
      <div class="hero__block recent-commands" id="recent_commands" hidden>
        <h2 class="section-title">最近</h2>
        <div class="cmd-chips" id="recent_commands_list" aria-label="最近查看的命令"></div>
      </div>
    </section>
  </main>
  <SiteFooter commandCount={commands.length} />
</BaseLayout>

<style>
  .page-home .site-main {
    padding-block: 1.25rem 2.5rem;
  }

  .hero {
    display: grid;
    gap: 0.85rem;
    max-width: 760px;
  }

  .hero__head {
    display: grid;
    gap: 0.35rem;
  }

  .hero__tag {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--accent-strong);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(1.65rem, 4.5vw, 2.35rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    margin: 0;
    font-size: var(--text-sm);
    max-width: 38rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero__links a {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .hero__links a:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .hero__block {
    margin-top: 0.5rem;
  }
</style>
