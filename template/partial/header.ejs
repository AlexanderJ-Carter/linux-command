<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge, chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#2d6a4f" media="(prefers-color-scheme: light)">
    <% if (describe.is_home) { %>
    <meta name="description" content="Linux 命令搜索引擎，收录 <%=describe.command_length%> 个命令手册与详解，值得收藏的速查工具。">
    <meta name="keywords" content="Linux,Command,命令大全,Linux命令手册,速查">
    <meta property="og:title" content="Linux 命令搜索引擎">
    <meta property="og:description" content="收录 <%=describe.command_length%> 个 Linux 命令，即搜即查。">
    <title>Linux 命令搜索引擎</title>
    <% } else if (describe.is_list_page) { %>
    <meta name="description" content="<%=describe.page_desc || describe.d%>">
    <meta name="keywords" content="Linux,Command,命令搜索,Linux命令手册">
    <meta property="og:title" content="<%=describe.page_title%> | Linux Command">
    <meta property="og:description" content="<%=describe.page_desc || describe.d%>">
    <title><%=describe.page_title%> | Linux Command</title>
    <% } else { %>
    <meta name="description" content="<%=describe.n%>: <%=describe.d%> - Linux 命令手册与详解">
    <meta name="keywords" content="Linux,<%=describe.n%>,Command,命令大全,<%=describe.d%>">
    <meta property="og:title" content="<%=describe.n%> 命令详解 | Linux Command">
    <meta property="og:description" content="<%=describe.d%>">
    <title><%=describe.n%> 命令详解 - <%=describe.d%> | Linux Command</title>
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="zh_CN">
    <link rel="shortcut icon" href="<%=relative_path%>img/favicon.ico">
    <link rel="preload" href="<%=relative_path%>css/index.css?v=<%=build_version%>" as="style">
    <link rel="stylesheet" type="text/css" href="<%=relative_path%>css/index.css?v=<%=build_version%>">
    <script src="<%=relative_path%>js/dark-mode.min.js"></script>
</head>
<body>
<dark-mode permanent dark="Dark" light="Light" class="theme-toggle" aria-label="切换深浅色主题"></dark-mode>
