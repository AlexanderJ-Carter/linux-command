<%- include('partial/header'); %>
<%- include('widget/search',{type: "list"}); %>
<div class="page-content hotlist">
  <div class="page-header">
    <h1>命令列表</h1>
    <p>共 <%= describe.command_length %> 个命令，按字母排序</p>
  </div>
  <nav class="alpha-nav" id="alpha_nav" aria-label="字母索引"></nav>
  <%
    const groups = {};
    describe.arr.forEach(function(page) {
      const first = (page.n && page.n[0] ? page.n[0] : '#').toUpperCase();
      const letter = /[A-Z]/.test(first) ? first : '#';
      if (!groups[letter]) groups[letter] = [];
      groups[letter].push(page);
    });
    const letters = Object.keys(groups).sort(function(a, b) {
      if (a === '#') return -1;
      if (b === '#') return 1;
      return a.localeCompare(b);
    });
  %>
  <% letters.forEach(function(letter) { %>
  <section class="alpha-group" id="letter-<%= letter %>">
    <h2 class="alpha-letter"><%= letter %></h2>
    <ul class="cmd-grid">
      <% groups[letter].forEach(function(page) { %>
      <li>
        <a class="cmd-card" href="c<%= page.p %>.html">
          <span class="cmd-card__name"><%= page.n %></span>
          <span class="cmd-card__desc"><%= page.d %></span>
        </a>
      </li>
      <% }); %>
    </ul>
  </section>
  <% }); %>
</div>
<%- include('widget/footer',{type: "list"}); %>
<%- include('partial/footer'); %>
