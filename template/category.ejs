<%- include('partial/header'); %>
<%- include('widget/search',{type: "list"}); %>
<div class="page-content category-page">
  <div class="page-header">
    <h1>按分类浏览</h1>
    <p>共 <%= describe.command_length %> 个命令，按用途分组</p>
  </div>

  <nav class="category-nav" aria-label="分类索引">
    <% describe.categories.forEach(function(cat) { %>
    <a class="category-nav__link" href="#cat-<%= cat.id %>"><%= cat.name %><span><%= cat.count %></span></a>
    <% }); %>
  </nav>

  <% describe.categories.forEach(function(cat) { %>
  <section class="category-group" id="cat-<%= cat.id %>">
    <h2 class="category-title"><%= cat.name %> <small><%= cat.count %></small></h2>
    <ul class="cmd-grid">
      <% cat.items.forEach(function(page) { %>
      <li>
        <a class="cmd-card" href="<%= relative_path %>c<%= page.p %>.html">
          <span class="cmd-card__name"><%= page.n %></span>
          <span class="cmd-card__desc"><%= page.d %></span>
        </a>
      </li>
      <% }); %>
    </ul>
  </section>
  <% }); %>
</div>
<%- include('widget/footer',{type: "list"}); %>
<%- include('partial/footer'); %>
