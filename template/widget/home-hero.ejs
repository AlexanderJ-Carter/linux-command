<section class="home-hero" aria-label="站点介绍">
  <p class="home-tagline">
    收录 <strong><%= describe.command_length %></strong> 个 Linux 命令，支持名称与说明全文搜索
  </p>
  <% if (describe.popular_commands && describe.popular_commands.length) { %>
  <div class="cmd-chips" aria-label="常用命令">
    <% describe.popular_commands.forEach(function(cmd) { %>
    <a class="cmd-chip" href="<%= relative_path %>c<%= cmd.p %>.html" title="<%= cmd.d %>"><%= cmd.n %></a>
    <% }); %>
  </div>
  <% } %>
  <div class="home-links">
    <a href="<%= relative_path %>hot.html">字母列表</a>
    <span class="footer-sep">·</span>
    <a href="<%= relative_path %>category.html">分类浏览</a>
    <span class="footer-sep">·</span>
    <a href="<%= relative_path %>list.html">高级搜索</a>
  </div>
  <div class="recent-commands" id="recent_commands" hidden>
    <h2 class="recent-commands__title">最近查看</h2>
    <div class="cmd-chips" id="recent_commands_list" aria-label="最近查看的命令"></div>
  </div>
</section>
