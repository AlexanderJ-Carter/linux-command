@import('mixins/reset.styl')
@import('mixins/markdown.styl')

mq-mobile = "screen and (max-width: 479px)"
mq-tablet = "screen and (max-width: 768px)"

:root
  --accent #2d6a4f
  --accent-soft rgba(45, 106, 79, 0.12)
  --text-muted #666
  --radius-sm 6px
  --radius-md 10px
  --shadow-sm 0 2px 8px rgba(0, 0, 0, 0.08)
  --shadow-md 0 8px 24px rgba(0, 0, 0, 0.12)

@media (prefers-reduced-motion: reduce)
  *
    animation-duration 0.01ms !important
    transition-duration 0.01ms !important

[data-color-mode*='dark'], [data-color-mode*='dark'] body {
  color-scheme: dark;
  --color-header-bg: rgba(30, 30, 30, 0.85);
  --color-header-border: #3a3a3a;
  --color-hover: rgba(255, 255, 255, 0.08);
  --text-muted: #aaa;
  --accent-soft: rgba(82, 183, 136, 0.15);
  --accent: #52b788;
}

[data-color-mode*='light'], [data-color-mode*='light'] body {
  color-scheme: light;
  --color-header-bg: rgba(255, 255, 255, 0.85);
  --color-header-border: #e5e5e5;
  --color-hover: #f5f5f5;
}

body
  font-size 14px
  line-height 1.6
  color var(--color-theme-text, inherit)

.theme-toggle
  position fixed
  left 10px
  top 8px
  z-index 999

[data-color-mode*='dark'] .header .search #result .ok
  background var(--color-hover)

.query:focus-visible,
.enter-input button:focus-visible,
.search-list a:focus-visible,
.cmd-chip:focus-visible,
.cmd-card:focus-visible,
.alpha-nav__link:focus-visible,
.back-to-top:focus-visible
  outline 2px solid var(--accent)
  outline-offset 2px

.wrapper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  .footer {
    padding-bottom: 100px;
  }
}

.header {
  width 517px
  margin 0 auto 0
  padding 0 10px
  .logo a {
    display flex
    color: currentColor;
  }
  .box {
    position relative
  }
  .search {
    min-height 20px
    position relative
    display table
    border-collapse separate
    li,ul {
      list-style none
    }
    #result {
      .ok {
        background var(--color-hover)
      }
    }
    .search-list {
      position absolute
      display none
      z-index 999
      box-shadow var(--shadow-md)
      border 1px solid var(--color-header-border)
      background var(--color-theme-bg)
      min-width 100px
      top 44px
      width 100%
      padding 6px
      border-radius var(--radius-md)
      max-height 320px
      overflow-y auto
      li {
        line-height 23px
        border-radius var(--radius-sm)
        span{
          padding 0 8px
          color var(--text-muted)
        }
      }
      a {
        display block
        padding 8px 10px
        border-radius var(--radius-sm)
        color inherit
        &:hover, &.ok {
          background-color var(--color-hover)
        }
        .kw {
          color var(--accent)
          font-style inherit
          font-weight bold
        }
      }
    }
    .query, .enter-input {
      display table-cell
      transition border-color ease-in-out 0.15s, box-shadow ease-in-out 0.15s
    }
    .query {
      resize: none;
      position relative
      z-index 2
      width 100%
      height 42px
      padding 8px 14px
      font-size 15px
      font-weight 500
      line-height 1.42857143
      background-color: transparent;
      background-image none
      border 1px solid $border-color
      border-radius var(--radius-md) 0 0 var(--radius-md)
      -webkit-appearance: none;
      &:focus {
        z-index 99
        border-color var(--accent)
        outline 0
        box-shadow 0 0 0 3px var(--accent-soft)
      }
    }
    .enter-input {
      white-space nowrap
      button {
        margin 0
        left -1px
        position relative
        z-index 5
        display inline-block
        padding 10px 24px
        font-size 14px
        font-weight 600
        line-height 1.42857143
        text-align center
        background-color var(--accent)
        color #fff
        border 1px solid var(--accent)
        border-radius 0 var(--radius-md) var(--radius-md) 0
        cursor pointer
        user-select none
        transition background-color 0.15s ease, border-color 0.15s ease
        &:hover {
          filter brightness(1.05)
        }
        &:active {
          filter brightness(0.95)
        }
      }
    }
  }
}

.footer {
  text-align center
  padding-top 31px
  font-size 14px
  font-weight 300
  border-top 1px solid var(--color-header-border)
  padding-bottom 50px;
  padding 31px 6px 50px 6px
  &.home {
    border-top 0
  }
  .fork-credit {
    font-size 12px
    color var(--text-muted)
    margin-bottom 0.75rem
  }
  .fork-credit a {
    color inherit
    text-decoration underline
  }
  .footer-nav {
    margin 0.5rem 0
    a {
      color inherit
      &:hover {
        color var(--accent)
      }
    }
  }
  .footer-sep {
    margin 0 0.35em
    color #bbb
  }
  .footer-meta {
    margin-top 0.75rem
    font-size 12px
    color var(--text-muted)
    kbd {
      display inline-block
      padding 1px 5px
      border 1px solid var(--color-header-border)
      border-radius 4px
      font-size 11px
      font-family inherit
      background var(--color-hover)
    }
  }
}
.header.home {
  .header_inner {
    display flex
    flex-direction column
    align-items center
  }
  .logo {
    min-height 120px
    display flex
    align-items center
  }
  .search {
    display flex
    min-width min(100%, 520px)
    width 100%
    max-width 520px
  }
}

.home-hero {
  text-align center
  max-width 640px
  margin 0 auto
  padding 0 16px 24px
  .home-tagline {
    font-size 15px
    color var(--text-muted)
    margin 0 0 20px
    strong {
      color var(--accent)
      font-size 18px
    }
  }
  .home-links {
    margin-top 16px
    font-size 13px
    a {
      color var(--accent)
      &:hover {
        text-decoration underline
      }
    }
  }
}

.cmd-chips {
  display flex
  flex-wrap wrap
  gap 8px
  justify-content center
}

.cmd-chip {
  display inline-block
  padding 6px 14px
  border-radius 999px
  background var(--accent-soft)
  color var(--accent)
  font-family ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size 13px
  font-weight 600
  border 1px solid transparent
  transition transform 0.15s ease, border-color 0.15s ease
  &:hover {
    border-color var(--accent)
    transform translateY(-1px)
  }
}

.page-content {
  padding 88px 20px 60px
  max-width 920px
  margin 0 auto
}

.page-header {
  margin-bottom 24px
  h1 {
    font-size 24px
    font-weight 700
    margin 0 0 6px
  }
  p, .search-meta {
    margin 0
    color var(--text-muted)
    font-size 14px
  }
}

.alpha-nav {
  display flex
  flex-wrap wrap
  gap 6px
  margin-bottom 28px
  padding 12px
  border 1px solid var(--color-header-border)
  border-radius var(--radius-md)
  background var(--color-hover)
  position sticky
  top 72px
  z-index 10
}

.alpha-nav__link {
  display inline-flex
  align-items center
  justify-content center
  min-width 28px
  height 28px
  padding 0 6px
  border-radius var(--radius-sm)
  font-size 12px
  font-weight 600
  color inherit
  &:hover {
    background var(--accent-soft)
    color var(--accent)
  }
}

.alpha-group {
  margin-bottom 32px
  scroll-margin-top 120px
}

.alpha-letter {
  font-size 20px
  font-weight 700
  color var(--accent)
  margin 0 0 12px
  padding-bottom 8px
  border-bottom 2px solid var(--accent-soft)
}

.cmd-grid {
  list-style none
  display grid
  grid-template-columns repeat(auto-fill, minmax(260px, 1fr))
  gap 10px
  padding 0
  margin 0
}

.cmd-card {
  display flex
  flex-direction column
  gap 4px
  padding 12px 14px
  border 1px solid var(--color-header-border)
  border-radius var(--radius-md)
  background var(--color-theme-bg)
  color inherit
  min-height 72px
  transition border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease
  &:hover {
    border-color var(--accent)
    box-shadow var(--shadow-sm)
    transform translateY(-1px)
  }
  &__name {
    font-family ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
    font-weight 700
    font-size 15px
    color var(--accent)
  }
  &__desc {
    font-size 12px
    color var(--text-muted)
    line-height 1.45
    display -webkit-box
    -webkit-line-clamp 2
    -webkit-box-orient vertical
    overflow hidden
  }
}

.breadcrumb {
  max-width 980px
  margin 0 auto
  padding 88px 35px 0
  font-size 13px
  color var(--text-muted)
  a {
    color var(--accent)
    &:hover {
      text-decoration underline
    }
  }
  .breadcrumb-sep {
    margin 0 0.4em
    opacity 0.5
  }
}

.cmd-page-header {
  max-width 980px
  margin 0 auto
  padding 16px 35px 0
}

.cmd-page-title {
  font-family ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size 28px
  font-weight 700
  margin 0 0 8px
  color var(--accent)
}

.cmd-page-desc {
  margin 0
  font-size 15px
  color var(--text-muted)
}

.back-to-top {
  position fixed
  right 20px
  bottom 24px
  z-index 100
  width 40px
  height 40px
  border none
  border-radius 50%
  background var(--accent)
  color #fff
  font-size 18px
  cursor pointer
  box-shadow var(--shadow-md)
  transition opacity 0.2s ease, transform 0.2s ease
  &:hover {
    transform translateY(-2px)
  }
  &[hidden] {
    display none
  }
}

.header.header_list {
  width auto
  position fixed
  width 100%
  background var(--color-theme-bg)
  backdrop-filter saturate(180%) blur(0.4rem)
  background-color var(--color-header-bg)
  z-index 99
}

.header_list {
  padding 10px 10px 10px 13px 
  border-bottom 1px solid var(--color-header-border)
  .logo {
    padding-right 24px
    text-align left
    svg {
      height 37px
      width 136px
    }
  }
}

.search_list {
  padding 0
  #search_list_result {
    list-style none
    padding 0
    margin 0
  }
  a {
    font-size 16px
    display block
    padding 12px 14px
    border 1px solid var(--color-header-border)
    border-radius var(--radius-md)
    margin-bottom 8px
    color inherit
    transition border-color 0.15s ease, background 0.15s ease
    &:hover {
      border-color var(--accent)
      background var(--color-hover)
    }
    strong {
      font-weight 700
      color var(--accent)
      font-family ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
    }
    .kw {
      color var(--accent)
      font-style inherit
      font-weight bold
    }
  }
  li {
    padding 0
    list-style-type none
    span {
      display block
      padding 24px
      text-align center
      color var(--text-muted)
    }
  }
}

.hotlist {
  padding 0
}

.header_list .header_inner {
  display: flex;
  align-items: center;
  .search {
    flex: 1;
    display: flex;
  }
}

.header_inner, .contributors {
  max-width 920px
  margin 0 auto
}

.contributors {
  padding 79px 27px
  max-width: 960px;
  font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji";
  font-size: 16px;
  line-height: 1.5;
  word-wrap: break-word;
  a {
    font-weight: bold;
  }
  .links {
    display: inline-flex;
    flex-wrap: wrap;
  }
  .links a {
    background: var(--color-theme-bg);
    height: 2.1rem;
    border-radius: 0.3rem;
    gap: 0.1rem;
    padding: 0rem 0.5rem 0rem 0.4rem;
  }
}

.alpha-group {
  content-visibility auto
  contain-intrinsic-size auto 480px
}

.category-nav {
  display flex
  flex-wrap wrap
  gap 8px
  margin 0 0 28px
  &__link {
    display inline-flex
    align-items center
    gap 6px
    padding 6px 12px
    border-radius 999px
    background var(--accent-soft)
    color var(--accent)
    font-size 13px
    span {
      font-size 11px
      opacity 0.7
    }
    &:hover {
      background var(--accent)
      color #fff
    }
  }
}

.category-group {
  content-visibility auto
  contain-intrinsic-size auto 420px
  margin-bottom 36px
}

.category-title {
  font-size 20px
  margin 0 0 14px
  padding-bottom 8px
  border-bottom 1px solid var(--color-header-border)
  small {
    font-size 13px
    color var(--text-muted)
    font-weight 400
    margin-left 8px
  }
}

.search-tips {
  display flex
  flex-wrap wrap
  gap 8px
  margin-top 12px
}

.search-tip {
  border 1px solid var(--color-header-border)
  background transparent
  color inherit
  border-radius 999px
  padding 4px 12px
  font-size 13px
  cursor pointer
  &:hover {
    border-color var(--accent)
    color var(--accent)
  }
}

.load-more-wrap {
  text-align center
  margin 20px 0 8px
}

.load-more-btn {
  border 1px solid var(--accent)
  background transparent
  color var(--accent)
  border-radius var(--radius-sm)
  padding 10px 28px
  font-size 14px
  cursor pointer
  &:hover {
    background var(--accent)
    color #fff
  }
  &[hidden] {
    display none
  }
}

.recent-commands {
  margin-top 28px
  &__title {
    font-size 14px
    font-weight 600
    margin 0 0 10px
    color var(--text-muted)
  }
}

.cmd-layout {
  max-width 1100px
  margin 0 auto
  padding 12px 35px 48px
  display grid
  grid-template-columns minmax(0, 1fr)
  gap 24px
}

.cmd-toc {
  order -1
  &__title {
    font-size 13px
    font-weight 600
    color var(--text-muted)
    margin-bottom 8px
  }
  &__list {
    list-style none
    margin 0
    padding 0
    display flex
    flex-wrap wrap
    gap 6px 14px
  }
  &__item {
    font-size 13px
    a {
      color var(--accent)
      &:hover {
        text-decoration underline
      }
    }
    &--h3 {
      opacity 0.85
      &::before {
        content '· '
        opacity 0.5
      }
    }
  }
}

.related-commands {
  margin-top 40px
  padding-top 24px
  border-top 1px solid var(--color-header-border)
  h2 {
    font-size 18px
    margin 0 0 12px
  }
}

@media (min-width: 1100px) {
  .cmd-layout {
    grid-template-columns 200px minmax(0, 1fr)
    align-items start
  }
  .cmd-toc {
    order 0
    position sticky
    top 88px
    &__list {
      display block
    }
    &__item {
      margin-bottom 6px
      &--h3 {
        padding-left 10px
        &::before {
          content none
        }
      }
    }
  }
}

@media mq-mobile {
  .header{
    width inherit
    .search .enter-input {
      button {
        padding 10px 16px
      }
    }
  }
  .header_list {
    padding: 10px 10px 10px 13px
    .logo {
      float inherit
      padding-right 10px
      text-align center
    }
    .logo svg {
      width 96px
    }
    .search {
      .query {
        line-height 31px
      }
    }
  }
  .page-content {
    padding 80px 16px 48px
  }
  .cmd-grid {
    grid-template-columns 1fr
  }
  .breadcrumb, .cmd-page-header, .cmd-layout {
    padding-left 16px
    padding-right 16px
  }
  .alpha-nav {
    top 64px
  }
}