<%- include('partial/header'); %>
<%- include('widget/search',{type: "list"}); %>
<div class="page-content search_list">
    <div class="page-header">
        <h1>搜索结果</h1>
        <p id="search_meta" class="search-meta">输入关键词开始搜索</p>
        <div class="search-tips" aria-label="搜索示例">
            <button type="button" class="search-tip" data-kw="压缩">压缩</button>
            <button type="button" class="search-tip" data-kw="权限">权限</button>
            <button type="button" class="search-tip" data-kw="网络">网络</button>
            <button type="button" class="search-tip" data-kw="进程">进程</button>
            <button type="button" class="search-tip" data-kw="磁盘">磁盘</button>
        </div>
    </div>
    <ul id="search_list_result"></ul>
    <div class="load-more-wrap">
        <button type="button" id="load_more_btn" class="load-more-btn" hidden>加载更多</button>
    </div>
</div>
<%- include('widget/footer',{type: "list"}); %>
