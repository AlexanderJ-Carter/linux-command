<%- include('partial/header'); %>
<%- include('widget/search',{type: "list"}); %>
<script type="text/javascript" src="<%=relative_path%>js/copy-to-clipboard.js"></script>

<nav class="breadcrumb" aria-label="面包屑">
  <a href="<%= relative_path %>index.html">首页</a>
  <span class="breadcrumb-sep">/</span>
  <a href="<%= relative_path %>category.html">分类</a>
  <span class="breadcrumb-sep">/</span>
  <a href="<%= relative_path %>hot.html">字母列表</a>
  <span class="breadcrumb-sep">/</span>
  <span aria-current="page"><%= describe.n %></span>
</nav>

<div class="cmd-page-header" data-cmd-name="<%= describe.n %>" data-cmd-path="<%= describe.p %>" data-cmd-desc="<%= describe.d %>">
  <h1 class="cmd-page-title"><%= describe.n %></h1>
  <p class="cmd-page-desc"><%= describe.d %></p>
</div>

<div class="cmd-layout">
  <nav class="cmd-toc" id="cmd_toc" aria-label="本页目录" hidden></nav>
  <div class="markdown-body">
  <% if(md_path){ %>
  <span class="edit_btn">
  <a target="_blank" rel="noopener" href="https://github.com/AlexanderJ-Carter/linux-command/edit/master<%=md_path%>">纠正错误</a>
  <span class="split"></span>
  <a target="_blank" rel="noopener" href="https://github.com/AlexanderJ-Carter/linux-command/edit/master<%=md_path%>">添加实例</a>
  </span>
  <% } %>

  <%-mdhtml%>

  <% if (describe.related && describe.related.length) { %>
  <section class="related-commands" aria-label="相关命令">
    <h2>相关命令</h2>
    <div class="cmd-chips">
      <% describe.related.forEach(function(cmd) { %>
      <a class="cmd-chip" href="<%= relative_path %>c<%= cmd.p %>.html" title="<%= cmd.d %>"><%= cmd.n %></a>
      <% }); %>
    </div>
  </section>
  <% } %>
  </div>
</div>
<%- include('widget/footer',{type: "list"}); %>
<%- include('partial/footer'); %>
